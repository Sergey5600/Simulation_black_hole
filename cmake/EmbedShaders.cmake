# Turns every GLSL file into a C++ raw string literal so the executable has no
# runtime file dependencies. `points.vert.glsl` becomes `bh::shaders::points_vert`.
# Editing a shader re-runs the configure step automatically (CONFIGURE_DEPENDS).
function(bh_embed_shaders out_header)
  set(content "// Generated by cmake/EmbedShaders.cmake from src/render/shaders/*.glsl. Do not edit.\n")
  string(APPEND content "#pragma once\n\nnamespace bh::shaders {\n\n")
  foreach(file ${ARGN})
    get_filename_component(name ${file} NAME)
    string(REGEX REPLACE "\\.glsl$" "" name ${name})
    string(MAKE_C_IDENTIFIER ${name} ident)
    file(READ ${file} source)
    string(APPEND content "inline constexpr const char* ${ident} = R\"GLSL(${source})GLSL\";\n\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${file})
  endforeach()
  string(APPEND content "}  // namespace bh::shaders\n")

  # Only touch the header when something changed, to avoid needless rebuilds.
  if(EXISTS ${out_header})
    file(READ ${out_header} previous)
  endif()
  if(NOT "${previous}" STREQUAL "${content}")
    file(WRITE ${out_header} "${content}")
  endif()
endfunction()
