# Third-party dependencies. Everything is fetched at configure time (needs git),
# except glad and stb which are vendored in third_party/.
include(FetchContent)
set(FETCHCONTENT_QUIET OFF)

# --- GLFW: window + input ---------------------------------------------------
set(GLFW_BUILD_DOCS OFF CACHE BOOL "" FORCE)
set(GLFW_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(GLFW_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(GLFW_INSTALL OFF CACHE BOOL "" FORCE)
# Wayland needs extra system packages on Linux; X11 (and XWayland) is enough.
set(GLFW_BUILD_WAYLAND OFF CACHE BOOL "")
FetchContent_Declare(glfw
  GIT_REPOSITORY https://github.com/glfw/glfw.git
  GIT_TAG 3.4
  GIT_SHALLOW TRUE)

# --- GLM: matrices for the renderer -----------------------------------------
FetchContent_Declare(glm
  GIT_REPOSITORY https://github.com/g-truc/glm.git
  GIT_TAG 1.0.1
  GIT_SHALLOW TRUE)

# --- Dear ImGui: UI -----------------------------------------------------------
FetchContent_Declare(imgui
  GIT_REPOSITORY https://github.com/ocornut/imgui.git
  GIT_TAG v1.91.9b
  GIT_SHALLOW TRUE)

FetchContent_MakeAvailable(glfw glm imgui)

add_library(imgui STATIC
  ${imgui_SOURCE_DIR}/imgui.cpp
  ${imgui_SOURCE_DIR}/imgui_draw.cpp
  ${imgui_SOURCE_DIR}/imgui_tables.cpp
  ${imgui_SOURCE_DIR}/imgui_widgets.cpp
  ${imgui_SOURCE_DIR}/imgui_demo.cpp
  ${imgui_SOURCE_DIR}/backends/imgui_impl_glfw.cpp
  ${imgui_SOURCE_DIR}/backends/imgui_impl_opengl3.cpp)
target_include_directories(imgui PUBLIC ${imgui_SOURCE_DIR} ${imgui_SOURCE_DIR}/backends)
target_link_libraries(imgui PUBLIC glfw)

# --- glad: OpenGL 4.6 core loader (vendored, generated by glad 2) ------------
add_library(glad STATIC ${PROJECT_SOURCE_DIR}/third_party/glad/src/gl.c)
target_include_directories(glad PUBLIC ${PROJECT_SOURCE_DIR}/third_party/glad/include)

# --- OpenMP: multithreaded CPU backend (optional) ----------------------------
find_package(OpenMP)
if(NOT OpenMP_CXX_FOUND)
  message(WARNING "OpenMP not found: the CPU backend will run single-threaded.")
endif()
